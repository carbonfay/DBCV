MCP_SERVICE_URL=http://mcp-dbcv:8005
MCP_HTTP_TIMEOUT=60
MCP_SERVICE_TOKEN=
MCP_REQUEST_TIMEOUT=120
MCP_OPENAI_MODEL=gpt-4o-mini
MCP_BACKEND_MAX_RETRIES=3

# ============================================================
