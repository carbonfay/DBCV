# Copy this file to `.env` in the project root and adjust values.

# --- Docker / Postgres ---
POSTGRES_DB=dbcv
POSTGRES_USER=dbcv
POSTGRES_PASSWORD=dbcv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# SQLAlchemy database URL (used by API and Alembic)
DATABASE_URL=postgresql+psycopg://dbcv:dbcv@localhost:5432/dbcv

